{
  "manifest_version": 3,
  "name": "Readwise Save Translated",
  "version": "0.1.4",
  "key": "",
  "description": "Save the current translated page HTML to Readwise Reader without custom parsing.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "tabs", "contextMenus"],
  "host_permissions": [
    "https://readwise.io/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_title": "Left click: save with original URL. Right click: default save, fallback mode, or open details."
  }
}
