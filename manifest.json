{
  "manifest_version": 3,
  "name": "Readwise Save Translated",
  "version": "0.1.0",
  "key": "",
  "description": "Save the current translated page HTML to Readwise Reader without custom parsing.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "contextMenus", "notifications"],
  "host_permissions": [
    "https://readwise.io/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Left click: save article-only. Right click: open details."
  }
}
